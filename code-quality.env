# Corporate Quality Gate Standards for MVP Lifecycle
MIN_GLOBAL_COVERAGE_PCT=60
MIN_CORE_RUNNER_COVERAGE_PCT=80
FAIL_ON_REGRESSION=true
OUTPUT_ARTIFACT_DIR=./coverage-reports

# Local Developer Performance Cache Overrides
TF_DATA_DIR="./.terraform-cache"
TF_CLI_ARGS_init="-plugin-dir=C:/WS/genesis/.terraform/providers"